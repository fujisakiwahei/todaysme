# Supabase
NUXT_PUBLIC_SUPABASE_URL=xxxxxxx
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=xxxxxxx
SUPABASE_SECRET_KEY=xxxxxxx

# Google
GOOGLE_CLIENT_ID=xxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxxx
# OAuth2 redirect URI (本番は https://<domain>/api/connections/google/callback)
GOOGLE_REDIRECT_URI=http://localhost:3000/api/connections/google/callback

# crypto
TOKEN_ENCRYPTION_KEY=xxxxxxx
# OAuth state 署名鍵 (任意。未設定なら TOKEN_ENCRYPTION_KEY 派生鍵を流用)
OAUTH_STATE_SECRET=

# Oura
OURA_CLIENT_ID=xxxxxxx
OURA_CLIENT_SECRET=xxxxxxx
OURA_REDIRECT_URI=http://localhost:3000/api/connections/oura/callback

# Toggl
TOGGL_API_TOKEN=xxxxxxx
